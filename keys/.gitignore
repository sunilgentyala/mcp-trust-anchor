# Never commit private keys to version control.
# This .gitignore protects the keys/ directory.

# Private key files (generated by generate_keys.py)
*_private.pem

# Any PEM file that might contain private key material
*.key
*.p8
*.p12
*.pfx

# Keep public keys and the key generator in version control
!*_public.pem
!generate_keys.py
!.gitignore
